generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  User              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Course {
  id                 String               @id
  uuid               String               @unique
  title              String
  slug               String               @unique
  subtitle           String?
  description        String?
  language           Language             @default(FR)
  level              CourseLevel
  publishedAt        DateTime?
  lastUpdatedAt      DateTime
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  categoryId         String
  instructorId       String
  schoolId           String?
  contentType        CourseType           @default(HYBRID)
  status             CourseStatus         @default(DRAFT)
  isPublic           Boolean              @default(false)
  requiresOnline     Boolean              @default(false)
  features           String[]
  requirements       String[]
  targetAudience     String[]
  learningObjectives String[]
  tags               String[]
  captions           Json?
  totalSizeBytes     BigInt?
  offlineAvailable   Boolean              @default(true)
  downloadPriority   Int                  @default(5)
  estimatedDataUsage String?
  Certificate        Certificate?
  Conversation       Conversation[]
  Category           Category             @relation(fields: [categoryId], references: [id])
  Instructor         Instructor           @relation(fields: [instructorId], references: [id])
  School             schools?             @relation(fields: [schoolId], references: [id])
  CourseEnrollment   CourseEnrollment[]
  FAQ                FAQ[]
  PromoVideo         PromoVideo?
  Review             Review[]
  Section            Section[]
  Statistics         Statistics?
  Version            Version?
  course_validations course_validations[]
  grades             grades[]
  Assignment         Assignment[]         @relation("AssignmentToCourse")
  Forum              Forum[]

  @@index([status])
  @@index([instructorId])
  @@index([publishedAt])
  @@index([slug])
}

model Question {
  id              String       @id
  order           Int
  type            QuestionType
  question        String
  points          Int          @default(20)
  options         Json?
  correctAnswer   Boolean?
  acceptedAnswers String[]
  orderingItems   Json?
  explanation     String?
  hint            String?
  partialCredit   Boolean      @default(false)
  quizId          String
  Quiz            Quiz         @relation(fields: [quizId], references: [id])

  @@index([quizId, order])
}

model Quiz {
  id                      String        @id
  title                   String?
  description             String?
  passingScore            Int?          @default(70)
  totalPoints             Int?          @default(100)
  timeLimit               Int?
  attemptsAllowed         Int?          @default(3)
  shuffleQuestions        Boolean       @default(false)
  shuffleAnswers          Boolean       @default(false)
  showCorrectAnswers      Boolean       @default(true)
  showCorrectAnswersAfter String?       @default("submission")
  questionCount           Int?          @default(0)
  lectureId               String        @unique
  Question                Question[]
  Lecture                 Lecture       @relation(fields: [lectureId], references: [id])
  QuizAttempt             QuizAttempt[]
}

model User {
  id                       String                    @id
  email                    String                    @unique
  phone                    String?
  firstName                String
  lastName                 String
  password                 String?
  role                     UserRole
  language                 Language                  @default(FR)
  lastLogin                DateTime?
  failedLoginAttempts      Int                       @default(0)
  lockedUntil              DateTime?
  avatar                   String?
  verified                 Boolean                   @default(false)
  verificationCode         String?
  codeExpires              DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime
  lastLoginAt              DateTime?
  schoolId                 String?
  settings                 Json?                      @default("{}")
  Account                  Account[]
  Admin                    Admin?
  AssignmentSubmission     AssignmentSubmission[]
  CodingSubmission         CodingSubmission[]
  Conversation             Conversation[]
  ConversationParticipant  ConversationParticipant[]
  CourseEnrollment         CourseEnrollment[]
  Instructor               Instructor?
  LectureProgress          LectureProgress[]
  Message                  Message[]
  MessageReadStatus        MessageReadStatus[]
  Note                     Note[]
  QuizAttempt              QuizAttempt[]
  Review                   Review[]
  School                   schools?                  @relation(fields: [schoolId], references: [id])
  audit_logs               audit_logs[]
  course_validations       course_validations[]
  download_queue           download_queue[]
  network_usage            network_usage[]
  notifications            notifications[]
  offline_content          offline_content[]
  offline_syncs            offline_syncs[]
  parents                  parents?
  sessions                 sessions[]
  students                 students?
  user_network_preferences user_network_preferences?
  CalendarEvent            CalendarEvent[]
  Report                   Report[]
  Announcement             Announcement[]
  Thread                   Thread[]
  Post                     Post[]
  UserBadge                UserBadge[]
  attendances              Attendance[]              @relation("AttendancesRecorded")
}

model AcademicPeriod {
  id        String    @id
  name      String
  startDate DateTime
  endDate   DateTime
  schoolId  String
  isActive  Boolean   @default(false)
  schools   schools   @relation(fields: [schoolId], references: [id])
  classes   classes[]
}

model Admin {
  id          String    @id
  role        AdminRole
  permissions Json?
  userId      String    @unique
  User        User      @relation(fields: [userId], references: [id])
}

model Article {
  id                   String   @id
  content              String?
  contentHtml          String?
  estimatedReadingTime Int?
  wordCount            Int?
  images               Json?
  updatedAt            DateTime
  lectureId            String   @unique
  Lecture              Lecture  @relation(fields: [lectureId], references: [id])
}

model Assignment {
  id                   String                 @id
  title                String?
  description          String?
  instructions         String?
  allowedFileTypes     String[]
  maxFileSize          Int?
  dueDate              DateTime?
  rubric               Json?
  lectureId            String                 @unique
  Lecture              Lecture                @relation(fields: [lectureId], references: [id])
  AssignmentSubmission AssignmentSubmission[]
  grades               grades[]
  classes              classes[]              @relation("AssignmentToClass")
  Course               Course[]               @relation("AssignmentToCourse")
}

model AssignmentSubmission {
  id           String           @id
  files        Json?
  submittedAt  DateTime         @default(now())
  grade        Float?
  feedback     String?
  status       SubmissionStatus @default(SUBMITTED)
  assignmentId String
  userId       String
  studentId    String?
  Assignment   Assignment       @relation(fields: [assignmentId], references: [id])
  students     students?        @relation(fields: [studentId], references: [id])
  User         User             @relation(fields: [userId], references: [id])

  @@index([assignmentId, userId])
}

model Category {
  id             String     @id
  name           String
  description    String?
  parentId       String?
  Category       Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  other_Category Category[] @relation("CategoryToCategory")
  Course         Course[]

  @@unique([name, parentId])
}

model Certificate {
  id                   String  @id
  available            Boolean @default(false)
  completionPercentage Int?    @default(100)
  quizzesRequired      Boolean @default(true)
  minimumQuizScore     Int?    @default(70)
  courseId             String  @unique
  Course               Course  @relation(fields: [courseId], references: [id])
}

model CodingExercise {
  id               String             @id
  title            String?
  instructions     String?
  starterCode      String?
  language         String?
  expectedOutput   String?
  testCases        Json?
  hints            String[]
  solution         String?
  allowSubmission  Boolean            @default(true)
  maxSubmissions   Int?
  lectureId        String             @unique
  Lecture          Lecture            @relation(fields: [lectureId], references: [id])
  CodingSubmission CodingSubmission[]
}

model CodingSubmission {
  id               String         @id
  code             String
  submittedAt      DateTime       @default(now())
  testsPassed      Int            @default(0)
  testsTotal       Int            @default(0)
  passed           Boolean        @default(false)
  output           String?
  error            String?
  codingExerciseId String
  userId           String
  studentId        String?
  CodingExercise   CodingExercise @relation(fields: [codingExerciseId], references: [id])
  students         students?      @relation(fields: [studentId], references: [id])
  User             User           @relation(fields: [userId], references: [id])

  @@index([codingExerciseId, userId])
  @@index([submittedAt])
}

model Conversation {
  id                      String                    @id
  name                    String?
  isGroup                 Boolean                   @default(false)
  creatorId               String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  contextType             ConversationContext?
  courseId                String?
  lectureId               String?
  Course                  Course?                   @relation(fields: [courseId], references: [id])
  User                    User?                     @relation(fields: [creatorId], references: [id])
  Lecture                 Lecture?                  @relation(fields: [lectureId], references: [id])
  ConversationParticipant ConversationParticipant[]
  Message                 Message[]

  @@index([courseId])
  @@index([creatorId])
  @@index([lectureId])
}

model ConversationParticipant {
  id             String       @id
  userId         String
  conversationId String
  joinedAt       DateTime     @default(now())
  isAdmin        Boolean      @default(false)
  Conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  User           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
  @@index([conversationId])
  @@index([userId])
}

model CourseEnrollment {
  id                 String    @id
  enrolledAt         DateTime  @default(now())
  lastAccessedAt     DateTime?
  progressPercentage Float     @default(0)
  completedLectures  Int       @default(0)
  totalTimeSpent     Int       @default(0)
  certificateEarned  Boolean   @default(false)
  favorited          Boolean   @default(false)
  archived           Boolean   @default(false)
  courseId           String
  userId             String
  studentId          String?
  currentLectureId   String?
  Course             Course    @relation(fields: [courseId], references: [id])
  Lecture            Lecture?  @relation(fields: [currentLectureId], references: [id])
  students           students? @relation(fields: [studentId], references: [id])
  User               User      @relation(fields: [userId], references: [id])

  @@unique([courseId, userId])
  @@index([courseId])
  @@index([userId])
}

model FAQ {
  id         String   @id
  question   String
  answer     String
  helpful    Int      @default(0)
  notHelpful Int      @default(0)
  createdAt  DateTime @default(now())
  courseId   String
  Course     Course   @relation(fields: [courseId], references: [id])

  @@index([courseId])
}

model Instructor {
  id                String              @id
  title             String?
  biography         String?
  rating            Float?
  totalStudents     Int?                @default(0)
  totalCourses      Int?                @default(0)
  website           String?
  social            Json?
  userId            String              @unique
  config            Json?
  Course            Course[]
  User              User                @relation(fields: [userId], references: [id])
  ClassToInstructor ClassToInstructor[]
}

model InvitationCode {
  id        String             @id
  code      String             @unique
  role      InvitationCodeRole
  schoolId  String
  createdBy String
  usedBy    String?            @unique
  isActive  Boolean            @default(true)
  expiresAt DateTime?
  createdAt DateTime           @default(now())
  usedAt    DateTime?
  schools   schools            @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([isActive])
  @@index([schoolId])
}

model Lecture {
  id                 String             @id
  title              String
  description        String?
  type               LectureType
  order              Int
  duration           Int?
  durationFormatted  String?
  isPreview          Boolean            @default(false)
  isFree             Boolean            @default(true)
  downloadPriority   Int?
  sectionId          String
  sizeBytes          BigInt?
  estimatedDataUsage String?
  offlineAvailable   Boolean            @default(true)
  Article            Article?
  Assignment         Assignment?
  CodingExercise     CodingExercise?
  Conversation       Conversation[]
  CourseEnrollment   CourseEnrollment[]
  Section            Section            @relation(fields: [sectionId], references: [id])
  LectureProgress    LectureProgress[]
  Note               Note[]
  Project            Project?
  Quiz               Quiz?
  Resource           Resource[]
  Video              Video?

  @@index([sectionId, order])
  @@index([type])
}

model LectureProgress {
  id                String    @id
  completed         Boolean   @default(false)
  completedAt       DateTime?
  lastActivityAt    DateTime?
  lastPosition      Int?      @default(0)
  watchedPercentage Float?    @default(0)
  attempts          Int?      @default(0)
  bestScore         Float?    @default(0)
  passed            Boolean?  @default(false)
  lectureId         String
  userId            String
  studentId         String?
  Lecture           Lecture   @relation(fields: [lectureId], references: [id])
  students          students? @relation(fields: [studentId], references: [id])
  User              User      @relation(fields: [userId], references: [id])

  @@unique([lectureId, userId])
  @@index([lectureId])
  @@index([userId])
}

model Message {
  id                String              @id
  conversationId    String
  senderId          String
  content           String
  createdAt         DateTime            @default(now())
  Conversation      Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  User              User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
  MessageReadStatus MessageReadStatus[]

  @@index([conversationId])
  @@index([senderId])
}

model MessageReadStatus {
  id        String   @id
  messageId String
  userId    String
  readAt    DateTime @default(now())
  Message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}

model Note {
  id        String    @id
  content   String
  timestamp Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime
  lectureId String
  userId    String
  studentId String?
  Lecture   Lecture   @relation(fields: [lectureId], references: [id])
  students  students? @relation(fields: [studentId], references: [id])
  User      User      @relation(fields: [userId], references: [id])

  @@index([lectureId, userId])
  @@index([userId])
}

model ParentChildLink {
  id          String         @id
  parentId    String
  studentId   String
  status      ApprovalStatus @default(PENDING)
  approvedBy  String?
  rejectedBy  String?
  reason      String?
  requestedAt DateTime       @default(now())
  reviewedAt  DateTime?

  @@unique([parentId, studentId])
  @@index([parentId])
  @@index([status])
  @@index([studentId])
}

model Project {
  id                 String   @id
  title              String?
  description        String?
  complexity         String?
  technologies       String[]
  learningObjectives String[]
  milestones         Json?
  submission         Json?
  lectureId          String   @unique
  Lecture            Lecture  @relation(fields: [lectureId], references: [id])
}

model PromoVideo {
  id        String  @id
  url       String
  duration  Int?
  thumbnail String?
  courseId  String  @unique
  Course    Course  @relation(fields: [courseId], references: [id])
}

model QuizAttempt {
  id             String    @id
  attemptNumber  Int
  startedAt      DateTime?
  submittedAt    DateTime?
  score          Float?
  pointsEarned   Int?
  pointsPossible Int?
  percentage     Float?
  passed         Boolean?
  timeSpent      Int?
  answers        Json?
  quizId         String
  userId         String
  studentId      String?
  Quiz           Quiz      @relation(fields: [quizId], references: [id])
  students       students? @relation(fields: [studentId], references: [id])
  User           User      @relation(fields: [userId], references: [id])

  @@index([quizId, userId])
  @@index([submittedAt])
}

model Resource {
  id                String       @id
  title             String
  type              ResourceType
  fileSize          Int?
  fileSizeFormatted String?
  url               String
  downloadable      Boolean      @default(true)
  lectureId         String
  Lecture           Lecture      @relation(fields: [lectureId], references: [id])

  @@index([lectureId])
}

model Review {
  id         String   @id
  rating     Int
  title      String?
  content    String?
  helpful    Int      @default(0)
  notHelpful Int      @default(0)
  createdAt  DateTime @default(now())
  courseId   String
  userId     String
  Course     Course   @relation(fields: [courseId], references: [id])
  User       User     @relation(fields: [userId], references: [id])

  @@unique([courseId, userId])
  @@index([courseId, rating])
}

model Section {
  id                String    @id
  title             String
  description       String?
  order             Int
  totalLectures     Int       @default(0)
  totalDuration     Int       @default(0)
  durationFormatted String?
  courseId          String
  Lecture           Lecture[]
  Course            Course    @relation(fields: [courseId], references: [id])

  @@index([courseId, order])
}

model Statistics {
  id                         String  @id
  totalSections              Int     @default(0)
  totalLectures              Int     @default(0)
  totalQuizzes               Int     @default(0)
  totalAssignments           Int     @default(0)
  totalArticles              Int     @default(0)
  totalDownloadableResources Int     @default(0)
  totalDuration              Int     @default(0)
  totalDurationFormatted     String?
  totalStudents              Int     @default(0)
  totalReviews               Int     @default(0)
  averageRating              Float?  @default(0)
  ratingDistribution         Json?
  completionRate             Float?  @default(0)
  lastMonthEnrollments       Int     @default(0)
  courseId                   String  @unique
  Course                     Course  @relation(fields: [courseId], references: [id])
}

model TeacherApproval {
  id          String         @id
  userId      String         @unique
  schoolId    String
  status      ApprovalStatus @default(PENDING)
  approvedBy  String?
  rejectedBy  String?
  reason      String?
  requestedAt DateTime       @default(now())
  reviewedAt  DateTime?

  @@index([schoolId])
  @@index([status])
  @@index([userId])
}

model Version {
  id                String   @id
  current           String
  publishedVersions String[]
  courseId          String   @unique
  Course            Course   @relation(fields: [courseId], references: [id])
}

model Video {
  id               String             @id
  versionId        String?
  version          Int?               @default(1)
  sources          Json?
  hlsUrl           String?
  dashUrl          String?
  thumbnail        String?
  thumbnailSprite  String?
  captions         Json?
  uploadedAt       DateTime?
  processedAt      DateTime?
  status           VideoStatus        @default(PROCESSING)
  updateNotes      String?
  lectureId        String             @unique
  defaultQuality   ContentQuality     @default(MEDIUM)
  offlineOptimized Boolean            @default(false)
  Lecture          Lecture            @relation(fields: [lectureId], references: [id])
  content_variants content_variants[]
}

model ClassToInstructor {
  A          String
  B          String
  classes    classes    @relation(fields: [A], references: [id], onDelete: Cascade)
  Instructor Instructor @relation(fields: [B], references: [id], onDelete: Cascade)

  @@id([A, B], map: "_ClassToInstructor_AB_pkey")
  @@index([B], map: "_ClassToInstructor_B_index")
  @@map("_ClassToInstructor")
}

model audit_logs {
  id         String   @id
  action     String
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())
  userId     String?
  User       User?    @relation(fields: [userId], references: [id])

  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@index([userId, createdAt])
}

model class_enrollments {
  id         String   @id
  enrolledAt DateTime @default(now())
  classId    String
  studentId  String
  classes    classes  @relation(fields: [classId], references: [id])
  students   students @relation(fields: [studentId], references: [id])

  @@unique([classId, studentId])
}

model classes {
  id                String              @id
  name              String
  degreeLevel       DegreeLevel
  subject           String?
  schoolId          String?
  academicPeriodId  String
  ClassToInstructor ClassToInstructor[]
  class_enrollments class_enrollments[]
  AcademicPeriod    AcademicPeriod      @relation(fields: [academicPeriodId], references: [id])
  schools           schools?            @relation(fields: [schoolId], references: [id])
  grades            grades[]
  Assignment        Assignment[]        @relation("AssignmentToClass")
  CalendarEvent     CalendarEvent[]
  Forum             Forum[]
  attendances       Attendance[]
}

model content_cache {
  id               String            @id
  contentType      CachedContentType
  contentId        String
  priority         CachePriority     @default(MEDIUM)
  sizeInBytes      BigInt
  version          String
  checksum         String?
  status           CacheStatus       @default(PENDING)
  downloadProgress Float             @default(0)
  cachedAt         DateTime?
  lastAccessedAt   DateTime?
  accessCount      Int               @default(0)
  expiresAt        DateTime?
  pinned           Boolean           @default(false)
  serverId         String
  school_servers   school_servers    @relation(fields: [serverId], references: [id])

  @@unique([serverId, contentType, contentId])
  @@index([contentType, contentId])
  @@index([lastAccessedAt])
  @@index([serverId, status])
}

model content_variants {
  id             String         @id
  contentType    String
  contentId      String
  quality        ContentQuality
  resolution     String?
  bitrate        Int?
  codec          String?
  format         String?
  url            String
  sizeInBytes    BigInt
  sizeFormatted  String
  duration       Int?
  isDefault      Boolean        @default(false)
  recommendedFor NetworkSpeed[]
  createdAt      DateTime       @default(now())
  videoId        String?
  Video          Video?         @relation(fields: [videoId], references: [id])

  @@unique([contentType, contentId, quality])
  @@index([contentType, contentId])
}

model course_validations {
  id          String           @id
  reviewerId  String
  status      ValidationStatus @default(PENDING)
  feedback    String?
  suggestions Json?
  reviewedAt  DateTime?
  courseId    String
  createdAt   DateTime         @default(now())
  Course      Course           @relation(fields: [courseId], references: [id])
  User        User             @relation(fields: [reviewerId], references: [id])

  @@unique([courseId, reviewerId])
}

model download_queue {
  id             String           @id
  deviceId       String
  contentType    String
  contentId      String
  variantQuality ContentQuality   @default(MEDIUM)
  priority       DownloadPriority @default(NORMAL)
  status         DownloadStatus   @default(QUEUED)
  progress       Float            @default(0)
  wifiOnly       Boolean          @default(true)
  scheduledFor   DateTime?
  estimatedSize  BigInt?
  downloadedSize BigInt           @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  retryCount     Int              @default(0)
  maxRetries     Int              @default(3)
  lastError      String?
  userId         String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  User           User             @relation(fields: [userId], references: [id])

  @@index([scheduledFor])
  @@index([status, priority])
  @@index([userId, status])
}

model grades {
  id             String      @id
  studentId      String
  score          Decimal
  maxScore       Decimal
  percentage     Float?
  letterGrade    String?
  academicPeriod String?
  gradedBy       String?
  gradedAt       DateTime    @default(now())
  feedback       String?
  assignmentId   String?
  gradableType   String?
  gradableId     String?
  courseId       String?
  classId        String?
  Assignment     Assignment? @relation(fields: [assignmentId], references: [id])
  classes        classes?    @relation(fields: [classId], references: [id])
  Course         Course?     @relation(fields: [courseId], references: [id])
  students       students    @relation(fields: [studentId], references: [id])

  @@index([classId])
  @@index([courseId])
  @@index([gradableType, gradableId])
  @@index([studentId])
}

model network_usage {
  id             String         @id
  deviceId       String
  date           DateTime       @default(now()) @db.Date
  dataDownloaded BigInt         @default(0)
  dataUploaded   BigInt         @default(0)
  videoData      BigInt         @default(0)
  documentData   BigInt         @default(0)
  imageData      BigInt         @default(0)
  otherData      BigInt         @default(0)
  connectionType ConnectionType
  userId         String
  User           User           @relation(fields: [userId], references: [id])

  @@unique([userId, deviceId, date, connectionType])
  @@index([userId, date])
}

model notifications {
  id        String               @id
  type      NotificationType
  title     String
  message   String
  data      Json?
  read      Boolean              @default(false)
  readAt    DateTime?
  actionUrl String?
  priority  NotificationPriority @default(NORMAL)
  createdAt DateTime             @default(now())
  expiresAt DateTime?
  userId    String
  User      User                 @relation(fields: [userId], references: [id])

  @@index([type, createdAt])
  @@index([userId, read, createdAt])
}

model offline_content {
  id             String          @id
  deviceId       String
  contentType    String
  contentId      String
  variantQuality ContentQuality?
  localPath      String?
  sizeInBytes    BigInt
  downloadedAt   DateTime
  lastAccessedAt DateTime
  accessCount    Int             @default(0)
  expiresAt      DateTime?
  pinned         Boolean         @default(false)
  autoDelete     Boolean         @default(true)
  needsUpdate    Boolean         @default(false)
  cloudVersion   String?
  localVersion   String?
  userId         String
  User           User            @relation(fields: [userId], references: [id])

  @@unique([userId, deviceId, contentType, contentId])
  @@index([expiresAt])
  @@index([lastAccessedAt])
  @@index([userId, deviceId])
}

model offline_syncs {
  id             String   @id
  deviceId       String
  lastSyncAt     DateTime
  pendingChanges Json?
  userId         String
  User           User     @relation(fields: [userId], references: [id])

  @@unique([userId, deviceId])
}

model parent_students {
  id           String   @id
  relationship String   @default("parent")
  isVerified   Boolean  @default(false)
  parentId     String
  studentId    String
  parents      parents  @relation(fields: [parentId], references: [id])
  students     students @relation(fields: [studentId], references: [id])

  @@unique([parentId, studentId])
}

model parents {
  id              String            @id
  userId          String            @unique
  config          Json?
  parent_students parent_students[]
  User            User              @relation(fields: [userId], references: [id])
}

model school_servers {
  id                 String             @id
  serverName         String
  ipAddress          String?
  macAddress         String?
  storageCapacity    Int
  storageUsed        Int                @default(0)
  status             ServerStatus       @default(ACTIVE)
  lastPingAt         DateTime?
  isMainServer       Boolean            @default(false)
  canServeContent    Boolean            @default(true)
  maxConcurrentUsers Int                @default(100)
  syncWithCloud      Boolean            @default(true)
  syncSchedule       String?
  lastSyncAt         DateTime?
  nextSyncAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime
  schoolId           String
  content_cache      content_cache[]
  schools            schools            @relation(fields: [schoolId], references: [id])
  server_sync_logs   server_sync_logs[]

  @@index([schoolId])
  @@index([status])
}

model schools {
  id             String           @id
  name           String
  code           String           @unique
  address        String?
  city           String?
  country        String           @default("Madagascar")
  timezone       String           @default("Indian/Antananarivo")
  config         Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  AcademicPeriod AcademicPeriod[]
  Course         Course[]
  InvitationCode InvitationCode[]
  User           User[]
  classes        classes[]
  school_servers school_servers[]
  CalendarEvent  CalendarEvent[]
  Announcement   Announcement[]
}

model server_sync_logs {
  id             String         @id
  syncType       SyncType
  startedAt      DateTime       @default(now())
  completedAt    DateTime?
  status         SyncStatus     @default(IN_PROGRESS)
  itemsSynced    Int            @default(0)
  itemsFailed    Int            @default(0)
  totalSize      BigInt         @default(0)
  errors         Json?
  serverId       String
  school_servers school_servers @relation(fields: [serverId], references: [id])

  @@index([serverId, startedAt])
  @@index([status])
}

model sessions {
  id           String   @id
  sessionToken String   @unique
  expires      DateTime
  userId       String
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model students {
  id                   String                 @id
  studentId            String?                @unique
  gradeLevel           String?
  birthDate            DateTime?
  userId               String                 @unique
  config               Json?
  AssignmentSubmission AssignmentSubmission[]
  CodingSubmission     CodingSubmission[]
  CourseEnrollment     CourseEnrollment[]
  LectureProgress      LectureProgress[]
  Note                 Note[]
  QuizAttempt          QuizAttempt[]
  class_enrollments    class_enrollments[]
  grades               grades[]
  parent_students      parent_students[]
  User                 User                   @relation(fields: [userId], references: [id])
  attendances          Attendance[]
}

model user_network_preferences {
  id                 String         @id
  autoDownload       Boolean        @default(false)
  wifiOnlyDownload   Boolean        @default(true)
  maxDailyData       Int?
  wifiQuality        ContentQuality @default(HIGH)
  cellularQuality    ContentQuality @default(LOW)
  prioritizeVideos   Boolean        @default(true)
  prioritizeQuizzes  Boolean        @default(true)
  prioritizeArticles Boolean        @default(true)
  syncSchedule       String?
  syncWindowStart    Int?
  syncWindowEnd      Int?
  autoDeleteWatched  Boolean        @default(false)
  keepDuration       Int?           @default(30)
  maxStorageGB       Int?
  userId             String         @unique
  createdAt          DateTime       @default(now())
  updatedAt          DateTime
  User               User           @relation(fields: [userId], references: [id])
}

// ------------------------------------------
// --- ENHANCEMENTS ADDED ON 2025-11-26 ---
// ------------------------------------------
// ===== 2. ENHANCED CALENDARING AND EVENT MANAGEMENT =====
model CalendarEvent {
  id          String    @id @default(uuid())
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  isAllDay    Boolean   @default(false)
  type        EventType
  schoolId    String?
  classId     String?
  userId      String?
  school      schools?  @relation(fields: [schoolId], references: [id])
  class       classes?  @relation(fields: [classId], references: [id])
  creator     User?     @relation(fields: [userId], references: [id])

  @@index([schoolId, startTime])
  @@index([classId, startTime])
}

// ===== 3. ADVANCED REPORTING AND ANALYTICS =====
model Report {
  id          String     @id @default(uuid())
  name        String
  type        ReportType
  generatedBy String
  generatedAt DateTime   @default(now())
  parameters  Json?
  data        Json
  format      String     @default("JSON")
  generator   User       @relation(fields: [generatedBy], references: [id])

  @@index([type, generatedAt])
}

// ===== 4. COMMUNITY AND COLLABORATION FEATURES =====
model Announcement {
  id         String    @id @default(uuid())
  title      String
  content    String
  authorId   String
  schoolId   String
  targetRole UserRole?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  author     User      @relation(fields: [authorId], references: [id])
  school     schools   @relation(fields: [schoolId], references: [id])

  @@index([schoolId, createdAt])
}

model Forum {
  id          String   @id @default(uuid())
  title       String
  description String?
  courseId    String?
  classId     String?
  course      Course?  @relation(fields: [courseId], references: [id])
  class       classes? @relation(fields: [classId], references: [id])
  threads     Thread[]
}

model Thread {
  id        String   @id @default(uuid())
  title     String
  forumId   String
  creatorId String
  createdAt DateTime @default(now())
  forum     Forum    @relation(fields: [forumId], references: [id])
  creator   User     @relation(fields: [creatorId], references: [id])
  posts     Post[]
}

model Post {
  id        String   @id @default(uuid())
  content   String
  threadId  String
  authorId  String
  createdAt DateTime @default(now())
  thread    Thread   @relation(fields: [threadId], references: [id])
  author    User     @relation(fields: [authorId], references: [id])
}

// ===== 5. GAMIFICATION AND STUDENT ENGAGEMENT =====
model Badge {
  id          String      @id @default(uuid())
  name        String      @unique
  description String
  imageUrl    String
  criteria    Json // e.g., { "completedCourses": 5, "quizScore": 95 }
  UserBadge   UserBadge[]
}

model UserBadge {
  id       String   @id @default(uuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id])
  badge    Badge    @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
}

// ===== ATTENDANCE MANAGEMENT =====
model Attendance {
  id           String           @id @default(uuid())
  studentId    String
  classId      String
  date         DateTime         @db.Date
  status       AttendanceStatus
  notes        String?
  recordedById String

  student    students @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class      classes  @relation(fields: [classId], references: [id], onDelete: Cascade)
  recordedBy User     @relation("AttendancesRecorded", fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([studentId, classId, date])
  @@index([studentId])
  @@index([classId])
  @@index([recordedById])
}

