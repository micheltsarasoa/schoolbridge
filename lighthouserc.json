{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start",
      "url": ["http://localhost:3000"],
      "numberOfRuns": 1,
      "serverReadyText": "ready - started server on",
      "serverReadyTimeout": 60000
    },
    "assert": {
      "assertions": {
        "categories.pwa.score": ["error", {"minScore": 0.85}]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}